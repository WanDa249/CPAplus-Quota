<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Stroke}"
        Background="{DynamicResource Surface}" Padding="20,16,20,18">
  <Border.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <Grid x:Name="PART_Track"><Border Background="{DynamicResource Track}" CornerRadius="3"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/></Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
        <StackPanel>
          <ToggleButton x:Name="ExpanderHeader" Cursor="Hand" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Foreground="{TemplateBinding Foreground}" Padding="1,8">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="HeaderBorder" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="Chevron" Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="10" Margin="10,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/></Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="HeaderBorder" Property="Opacity" Value="0.7"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="&#xE70E;"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter x:Name="ExpandedContent" ContentSource="Content" Visibility="Collapsed"/>
        </StackPanel>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Padding" Value="10,10"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
        <Border x:Name="PasswordBorder" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border CornerRadius="7" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Padding="10,9"><DockPanel><TextBlock Text="&#xE70D;" DockPanel.Dock="Right" FontFamily="Segoe Fluent Icons" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0"/><ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" VerticalAlignment="Center"/></DockPanel></Border></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
            <Border Background="{DynamicResource MenuSurface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="5" Margin="0,5,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="180"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
          </Popup>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="5" Padding="9,8"><ContentPresenter/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Hover}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal">
          <Border x:Name="CheckBorder" Width="18" Height="18" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Muted}" Background="Transparent">
            <TextBlock x:Name="CheckGlyph" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
          </Border>
          <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckGlyph" Property="Opacity" Value="1"/><Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Border.Resources>
  <StackPanel>
    <DockPanel Margin="0,0,0,17" LastChildFill="True">
      <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" ToolTip="收起" AutomationProperties.Name="收起" Width="30" Height="30" Padding="0"/>
      <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="&#xE713;" FontFamily="Segoe Fluent Icons" ToolTip="设置" AutomationProperties.Name="设置" Width="30" Height="30" Padding="0" Margin="0,0,4,0"/>
      <Button x:Name="BackButton" DockPanel.Dock="Left" Content="&#xE72B;" FontFamily="Segoe Fluent Icons" ToolTip="返回额度" AutomationProperties.Name="返回额度" Width="30" Height="30" Padding="0" Margin="-6,0,6,0" Visibility="Collapsed"/>
      <TextBlock x:Name="Heading" Text="Codex 额度" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
    </DockPanel>
    <StackPanel x:Name="HomePage">
      <Border x:Name="MainCard" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="17,16,17,15">
        <StackPanel>
          <DockPanel>
            <Border x:Name="StateBadge" DockPanel.Dock="Right" CornerRadius="5" Padding="7,3" VerticalAlignment="Center"><TextBlock x:Name="AccountState" FontSize="12"/></Border>
            <TextBlock x:Name="AccountName" FontSize="17" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
          </DockPanel>
          <Grid x:Name="Metrics" Margin="0,19,0,0">
            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="19"/><RowDefinition/></Grid.RowDefinitions>
            <StackPanel x:Name="FiveMetric">
              <DockPanel><TextBlock x:Name="FiveValue" DockPanel.Dock="Right" FontSize="24" FontWeight="Medium"/><TextBlock Text="五小时" FontSize="13" VerticalAlignment="Center"/></DockPanel>
              <ProgressBar x:Name="FiveBar" Height="5" Maximum="100" BorderThickness="0" Margin="0,8,0,0"/>
              <TextBlock x:Name="FiveReset" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="2">
              <DockPanel><TextBlock x:Name="WeekValue" DockPanel.Dock="Right" FontSize="24" FontWeight="Medium"/><TextBlock Text="周额度" FontSize="13" VerticalAlignment="Center"/></DockPanel>
              <ProgressBar x:Name="WeekBar" Height="5" Maximum="100" BorderThickness="0" Margin="0,8,0,0"/>
              <TextBlock x:Name="WeekReset" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="UnavailableHint" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Border>
      <DockPanel Margin="2,10,0,10">
        <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新" Width="76" Padding="8,5" ToolTip="刷新当前主账号额度，查询期间可继续浏览或收起窗口" AutomationProperties.Name="刷新"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="UpdatedText" FontSize="12" Foreground="{DynamicResource Muted}"/>
          <TextBlock x:Name="CacheNote" FontSize="12" MinHeight="18" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,3,0,0"/>
        </StackPanel>
      </DockPanel>
      <Expander x:Name="OtherAccounts" Foreground="{DynamicResource Muted}" FontSize="12" IsExpanded="False" BorderThickness="0">
        <ScrollViewer x:Name="OtherScroll" MaxHeight="235" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly" Margin="0,8,0,0" Padding="0,0,6,0">
          <ScrollViewer.Template><ControlTemplate TargetType="ScrollViewer">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}"/>
              <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Width="6" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
            </Grid>
          </ControlTemplate></ScrollViewer.Template>
          <ScrollViewer.Resources>
            <Style TargetType="ScrollBar">
              <Setter Property="Width" Value="6"/>
              <Setter Property="MinWidth" Value="0"/>
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                  <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                  <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbFill" Background="{DynamicResource Muted}" Opacity="0.28" CornerRadius="3" Margin="1,0"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbFill" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                  <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                </Track>
              </ControlTemplate></Setter.Value></Setter>
            </Style>
          </ScrollViewer.Resources>
          <StackPanel x:Name="AccountRows"/>
        </ScrollViewer>
      </Expander>
      <TextBlock x:Name="FailureText" FontSize="12" Height="18" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="2,8,2,0" Foreground="{DynamicResource Warning}" Visibility="Hidden"/>
      <Button x:Name="ConnectButton" Content="打开设置" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,7,0,0"/>
    </StackPanel>
    <StackPanel x:Name="KeyPage" Visibility="Collapsed">
      <TextBlock Text="查看此密钥绑定账号的额度。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18"/>
      <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="16">
        <StackPanel>
          <TextBlock Text="HTTPS 服务地址" FontWeight="Medium" Margin="0,0,0,10"/>
          <TextBox x:Name="ServerInput" MaxLength="2048" AutomationProperties.Name="HTTPS 服务地址" Margin="0,0,0,14"/>
          <TextBlock Text="CPA API Key" FontWeight="Medium" Margin="0,0,0,10"/>
          <PasswordBox x:Name="KeyInput" MaxLength="512" AutomationProperties.Name="CPA API Key"/>
          <TextBlock x:Name="CurrentKeySummary" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,9,0,0"/>
          <TextBlock Text="安全保存在 Windows 凭据管理器" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
      </Border>
      <TextBlock x:Name="KeyError" FontSize="12" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Visibility="Collapsed" Margin="2,10,2,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button x:Name="CancelKeyButton" Content="取消" Foreground="{DynamicResource Muted}" Margin="0,0,6,0"/>
        <Button x:Name="SaveKeyButton" Content="保存并连接" FontWeight="Medium" Foreground="{DynamicResource Accent}" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Stroke}" Padding="14,8"/>
      </StackPanel>
    </StackPanel>
    <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
      <WrapPanel x:Name="RoutingActions" Visibility="Collapsed" Margin="0,0,0,12">
        <Button x:Name="UsePrimaryButton" Content="优先使用此账号"/>
        <Button x:Name="AutoRouteButton" Content="恢复自动排序"/>
      </WrapPanel>
      <TextBlock Text="账号备注" FontWeight="Medium" Margin="0,0,0,8"/>
      <TextBox x:Name="NoteInput" MaxLength="40" AutomationProperties.Name="本地账号备注"/>
      <DockPanel Margin="0,6,0,16">
        <Button x:Name="SaveNoteButton" DockPanel.Dock="Right" Content="保存备注"/>
        <TextBlock x:Name="RawAlias" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock Text="显示方式" FontWeight="Medium" Margin="0,0,0,8"/>
      <ComboBox x:Name="DisplayMode" FontSize="12" Padding="8,5" AutomationProperties.Name="任务栏显示方式"/>
      <CheckBox x:Name="PinSetting" Content="详情窗口保持置顶" FontSize="12" Foreground="{DynamicResource Ink}" Margin="1,13,0,19"/>
      <CheckBox x:Name="EdgeSetting" Content="贴边自动收纳" FontSize="12" Foreground="{DynamicResource Ink}" ToolTip="开启后，将标题拖到屏幕外侧的左边缘或右边缘。悬停展开，离开收起。" Margin="1,0,0,8"/>
      <TextBlock Text="拖到左右外侧边缘启用，拖回即可取消。" FontSize="11" Foreground="{DynamicResource Muted}" Margin="23,0,0,16"/>
      <CheckBox x:Name="StartupSetting" Content="登录 Windows 后静默启动" FontSize="12" Foreground="{DynamicResource Ink}" Margin="1,0,0,19"/>
      <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,0,0,16"/>
      <TextBlock Text="连接" FontWeight="Medium" Margin="0,0,0,8"/>
      <TextBlock x:Name="ServerAddress" FontSize="12" Foreground="{DynamicResource Muted}"/>
      <DockPanel Margin="0,7,0,6">
        <Button x:Name="ChangeKeyButton" DockPanel.Dock="Right" Content="更换密钥"/>
        <TextBlock x:Name="KeyLabel" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
      </DockPanel>
      <Expander Header="连接详情" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,6,0,0">
        <TextBlock Text="使用 HTTPS 连接 CPA 服务。&#10;密钥保存在 Windows 凭据管理器。&#10;每 15 秒自动查询额度，更新时间以上次成功结果为准。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
      </Expander>
      <TextBlock x:Name="SettingsNotice" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
  </StackPanel>
</Border>
